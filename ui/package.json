{
  "name": "@pandu/ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-size.mjs",
    "size": "node scripts/check-size.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "screenshots": "playwright test tests/e2e/visual.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
