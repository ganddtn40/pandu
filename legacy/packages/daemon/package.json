{
  "name": "@cockpit/daemon",
  "version": "0.1.0",
  "description": "Cockpit local recording proxy, storage engine, and control API",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests drizzle.config.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@cockpit/core": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
